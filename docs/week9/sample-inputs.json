{
  "title": "邻宠帮 AI 需求解析样例输入集",
  "version": "0.1",
  "date": "2026-11-03",
  "description": "第九周代表性样例初版。样例来自三类字段设计文档中的原始示例及其明确规则所要求的边界变体；用于 Prompt 走查和 Schema 校验，不等同于最终约 45 条人工标注评估集。",
  "output_contract": {
    "draft": "按 service_type 使用对应场景的 AI 中间字段",
    "questions": "顶层字符串数组；无待问问题时为 []"
  },
  "cases": [
    {
      "id": "EB-01",
      "scene": "errand_buy",
      "kind": "source_example",
      "user_input": "帮我买一袋猫粮，预算100元以内，送到社区东门。",
      "context": {},
      "expected": {
        "service_type": "errand_buy",
        "product_name": "猫粮",
        "product_detail": null,
        "quantity": 1,
        "unit": "袋",
        "budget_max": 100,
        "delivery_location": "社区东门",
        "delivery_time": null,
        "precautions": null,
        "questions_should_cover": [
          "商品细节是否有要求",
          "具体送达时间范围"
        ]
      },
      "notes": "商品细节是可选补问；具体送达时间无法从输入确定，最终创建前必须补问。"
    },
